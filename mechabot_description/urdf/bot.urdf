<?xml version="1.0" ?>
<robot name="bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.2 0.05"/>
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 1.57"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
    </joint>

    <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
    </material>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.04" length="0.02"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="right_wheel_joint" type="fixed">
        <origin xyz="0.0 -0.11 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
    </joint>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.04" length="0.02"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="left_wheel_joint" type="fixed">
        <origin xyz="0.0 0.11 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
    </joint>

    <link name="front_castor_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.0075"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="front_castor_joint" type="fixed">
        <origin xyz="0.04 0.0 -0.025" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="front_castor_link"/>
    </joint>

    <link name="rear_castor_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.0075"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="rear_castor_joint" type="fixed">
        <origin xyz="-0.04 0.0 -0.025" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="rear_castor_link"/>
    </joint>

</robot>