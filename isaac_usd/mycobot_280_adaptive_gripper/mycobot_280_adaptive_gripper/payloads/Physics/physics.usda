#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "firefighter"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "firefighter"
{
    over "Geometry"
    {
        over "g_base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            float physics:density = 1000

            over "joint2" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float physics:density = 1000

                over "joint3" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    float physics:density = 1000

                    over "joint4" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        float physics:density = 1000

                        over "joint5" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                        )
                        {
                            float physics:density = 1000

                            over "joint6" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                            )
                            {
                                float physics:density = 1000

                                over "joint6_flange" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                )
                                {
                                    float physics:density = 1000

                                    over "gripper_left3" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        float physics:density = 1000

                                        over "gripper_left1" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                        )
                                        {
                                            float physics:density = 1000
                                        }
                                    }

                                    over "gripper_left2" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        float physics:density = 1000
                                    }

                                    over "gripper_right3" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        float physics:density = 1000

                                        over "gripper_right1" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                        )
                                        {
                                            float physics:density = 1000
                                        }
                                    }

                                    over "gripper_right2" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        float physics:density = 1000
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "joint2_to_joint1" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 17.453293
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 2
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </firefighter/Geometry/g_base>
            custom rel physics:body1
            append rel physics:body1 = </firefighter/Geometry/g_base/joint2>
            point3f physics:localPos0 = (0, 0, 0.13156)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -167.99695
            float physics:upperLimit = 167.99695
            custom float urdf:limit:effort = 1000
        }

