#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "tn__a0000000000000000000000000000000_al0DIN"
    {
        color3f inputs:diffuseColor = (0.95597297, 0.95597297, 0.95597297)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/tn__a0000000000000000000000000000000_al0DIN.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "material0"
    {
        asset inputs:DiffuseTexture = @@
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/material0/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/material0/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/material0/DiffuseTexture.outputs:rgb>
            prepend float inputs:metallic.connect = </Materials/material0.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/material0.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/material0.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (1, 1, 1, 1)
            prepend asset inputs:file.connect = </Materials/material0.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/material0/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/material0.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/material0.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}

