        def PhysicsFixedJoint "lidar_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </mechabot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </mechabot/Geometry/base_footprint/base_link/lidar_link>
            point3f physics:localPos0 = (0.044962, 0, 0.16914)
            point3f physics:localPos1 = (27.99975, 0, 132.00015)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "camera_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </mechabot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </mechabot/Geometry/base_footprint/base_link/camera_link>
            point3f physics:localPos0 = (0.189484, 0, 0.112524)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "imu_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </mechabot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </mechabot/Geometry/base_footprint/base_link/imu_link>
            point3f physics:localPos0 = (0, 0, 0.031846)
            point3f physics:localPos1 = (0, 0, 35)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
