        prepend references = @./geometries.usd@</Geometries/mechabot_base_link>
    )
    {
        over "mechabot_base_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mechabot_base_link/VisualMaterials/grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "grey" (
