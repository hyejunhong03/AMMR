  </joint>

  <link name="toplid_link">
    <inertial>
      <origin xyz="0.0 0.0 -0.001125" rpy="0.0 0.0 0.0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 -0.1125" rpy="0.0 0.0 0.0"/>
      <geometry>
