  <link name="rear_right_castor_link">
    <inertial>
      <origin xyz="0.085 0.065 -0.0205" rpy="0.0 0.0 0.0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
